{
  "expo": {
    "name": "Holdit",
    "slug": "holdit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "holdit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1D3C44"
    },
    "android": {
      "package": "com.holdit.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee26d5fa-014e-4efb-b4e6-537566bd9ef3"
      }
    },
    "owner": "sidu"
  }
}
